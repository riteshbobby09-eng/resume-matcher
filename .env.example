# ============================================================
# Resume Matcher — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# Path to YAML configuration file (default: config/default.yaml)
RESUME_MATCHER_CONFIG_PATH=config/default.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
RESUME_MATCHER_LOG_LEVEL=INFO

# Base directory for data storage (documents, results, exports)
RESUME_MATCHER_DATA_DIR=data

# Directory for temporary file processing
RESUME_MATCHER_TEMP_DIR=

# Sentence Transformers model cache directory (optional)
SENTENCE_TRANSFORMERS_HOME=

# Maximum number of worker threads for batch processing
RESUME_MATCHER_MAX_WORKERS=4
